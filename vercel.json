{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/backend/server.js" },
    { "source": "/:shortCode([a-zA-Z0-9]{6})", "destination": "/backend/server.js" },
    { "source": "/((?!api|assets|.*\\..*).*)", "destination": "/frontend/index.html" }
  ],
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ]
}
